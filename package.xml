<?xml version="1.0"?>
<package format="3">
  <name>turtlebot_flatland</name>
  <version>0.0.0</version>
  <description>
    Flatland port of the stdr version of turtlebot simulation. Convenient to test 2D-navigation related stuffs
  </description>

  <maintainer email="joseph@avidbots.com">Joseph Duchesne</maintainer>
  <author email="mehdi.tlili@gmail.com">Joseph Duchesne</author>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>flatland_server</exec_depend>
  <exec_depend>flatland_plugins</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
